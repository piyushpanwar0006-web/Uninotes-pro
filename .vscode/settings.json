{
  // Configure the built-in CSS linter to ignore Tailwind directives.
  // This allows CSS validation to remain active while ignoring @tailwind, @apply, etc.
  "css.validate": true,
  "less.validate": true,
  "scss.validate": true,
  "css.lint.unknownAtRules": "ignore",
  "less.lint.unknownAtRules": "ignore",
  "scss.lint.unknownAtRules": "ignore",

  // Recommended: install Tailwind CSS IntelliSense for autocomplete + hover docs
  "extensions.recommendations": ["bradlc.vscode-tailwindcss"]
}
